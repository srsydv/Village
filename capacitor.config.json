{
  "appId": "com.safartravel.app",
  "appName": "Safar",
  "webDir": "client/dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "appStartPath": "/"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#070B14"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "disable"
    }
  }
}
