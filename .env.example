GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PORT=3001

# Public HTTPS origin after you deploy (no trailing slash).
# Used for Play AAB API calls and as the privacy-policy host.
# Optional. If set, activity is stored in MongoDB (Atlas free cluster is enough).
# If unset, activity is written to .data/activity.jsonl on this machine.
MONGODB_URI=
MONGODB_DB=aurea
ACTIVITY_SECRET=
